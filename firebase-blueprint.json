{
  "entities": {
    "student": {
      "title": "Student",
      "description": "Registered exam student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "absentNumber": { "type": "string" },
        "studentClass": { "type": "string" },
        "status": { "type": "string", "enum": ["BELUM_MULAI", "SEDANG_MENGERJAKAN", "TERKUNCI", "SELESAI"] },
        "violationCount": { "type": "integer" },
        "lockedReason": { "type": "string" },
        "score": { "type": "number" },
        "correctAnswersCount": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "answers": { "type": "object" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "lastActive": { "type": "string" }
      },
      "required": ["id", "name", "absentNumber", "studentClass", "status", "violationCount", "answers"]
    },
    "question": {
      "title": "Question",
      "description": "An exam question",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "questionText": { "type": "string" },
        "imageUrl": { "type": "string" },
        "options": { "type": "array" },
        "optionImages": { "type": "array" },
        "correctAnswerIndex": { "type": "integer" },
        "correctAnswerIndices": { "type": "array" },
        "type": { "type": "string", "enum": ["MC", "MR"] },
        "score": { "type": "integer" }
      },
      "required": ["id", "questionText", "options"]
    },
    "examConfig": {
      "title": "ExamConfig",
      "description": "Exam parameters configuration",
      "type": "object",
      "properties": {
        "durationMinutes": { "type": "integer" },
        "examTitle": { "type": "string" }
      },
      "required": ["durationMinutes", "examTitle"]
    },
    "studentUser": {
      "title": "StudentUser",
      "description": "Pre-registered student credentials for exam login",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "studentClass": { "type": "string" },
        "absentNumber": { "type": "string" }
      },
      "required": ["id", "username", "password", "name", "studentClass", "absentNumber"]
    },
    "studentAccountChunk": {
      "title": "StudentAccountChunk",
      "description": "Chunked pre-registered student user records",
      "type": "object",
      "properties": {
        "chunkIndex": { "type": "integer" },
        "users": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["chunkIndex", "users"]
    }
  },
  "firestore": {
    "students/{studentId}": {
      "schema": "student",
      "description": "Collection of students taking exams"
    },
    "questions/{questionId}": {
      "schema": "question",
      "description": "Collection of questions for the exam"
    },
    "config/{configDocId}": {
      "schema": "examConfig",
      "description": "Configuration documents for global exam parameters and seed metadata"
    },
    "studentUsers/{userId}": {
      "schema": "studentUser",
      "description": "Pre-registered student user authentication records"
    },
    "studentAccounts/{chunkId}": {
      "schema": "studentAccountChunk",
      "description": "Chunked storage for large batches of student users"
    }
  }
}
