rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Students collection (taking exams / monitoring sessions)
    match /students/{studentId} {
      allow read: if true;
      allow write: if isValidId(studentId);
    }

    // 2. Questions collection
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isValidId(questionId);
    }

    // 3. Config collection (examConfig, seedMeta, userMeta, etc.)
    match /config/{configDocId} {
      allow read: if true;
      allow write: if isValidId(configDocId);
    } 

    // 4. Student Users (pre-registered accounts for login authentication)
    match /studentUsers/{userId} {
      allow read, write: if isValidId(userId);
    }

    // 5. Student Accounts Chunks (for high-performance storage of 1,200+ student accounts)
    match /studentAccounts/{chunkId} {
      allow read, write: if isValidId(chunkId);
    }
  }
}
